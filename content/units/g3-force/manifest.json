{
  "id": "g3-force",
  "title": "힘과 우리 생활",
  "grade": 3,
  "standards": ["4과01-02", "4과01-04"],
  "engine": "physics",
  "experiments": [
    {
      "id": "lever-balance",
      "module": "lever-balance",
      "title": "막대의 수평 잡기",
      "question": "막대의 수평을 잡으려면 물체를 어디에 놓아야 할까?",
      "predictionPrompt": "예측: 오른쪽 끝의 높이는?",
      "variables": [
        {
          "key": "count",
          "label": "오른쪽 추의 수",
          "type": "choice",
          "unit": "개",
          "options": [
            { "value": 1, "label": "1개" },
            { "value": 2, "label": "2개" },
            { "value": 4, "label": "4개" }
          ],
          "default": 2
        },
        {
          "key": "distance",
          "label": "오른쪽 추의 거리",
          "type": "choice",
          "unit": "칸",
          "options": [
            { "value": 2, "label": "받침점에서 2칸" },
            { "value": 4, "label": "받침점에서 4칸" },
            { "value": 8, "label": "받침점에서 8칸" }
          ],
          "default": 4
        },
        {
          "key": "shape",
          "label": "추의 모양",
          "type": "choice",
          "options": [
            { "value": "cylinder", "label": "원기둥" },
            { "value": "cube", "label": "정육면체" }
          ],
          "default": "cylinder"
        }
      ],
      "dependent": [
        { "key": "rightHeightCm", "label": "오른쪽 끝의 높이", "unit": "cm" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": [],
      "safetyNotices": [],
      "limits": ["지레", "돌림힘", "모멘트", "평형", "관성", "토크"],
      "params": { "durationS": 1 },
      "tutor": {
        "forbiddenAnswers": [
          "무거운 쪽으로 기울",
          "받침점에서 멀수록 더 많이 기울",
          "무거운 물체를 받침점에 가깝게",
          "가벼운 물체를 받침점에서 멀리",
          "무게와 거리를 곱",
          "모양은 관계없"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 막대가 어느 쪽으로 기울지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 막대가 다르게 기운 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 막대는 어떻게 달라졌나요? 눈으로 보기 그림과 그래프를 함께 볼까요?" },
          { "when": "fair-test", "iv": "distance", "text": "추의 거리만 바꾸었어요. 같은 추라도 놓는 자리에 따라 막대가 어떻게 달라졌나요? 수평이 된 자리가 있었나요?" },
          { "when": "fair-test", "iv": "count", "text": "추의 수만 바꾸었어요. 추가 늘었을 때 수평을 다시 잡으려면 추를 어디로 옮겨 보면 좋을까요?" },
          { "when": "fair-test", "iv": "shape", "text": "모양만 바꾸었을 때 막대는 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. '돌리려는 정도 보기' 그림에서 양쪽 막대 길이를 비교해 볼까요?" }
        ]
      }
    },
    {
      "id": "lever-lift",
      "module": "lever-lift",
      "title": "지레와 빗면으로 들어 올리기",
      "question": "도구를 쓰면 물체를 들어 올리는 힘이 어떻게 달라질까?",
      "predictionPrompt": "예측: 용수철저울의 눈금은?",
      "variables": [
        {
          "key": "tool",
          "label": "쓰는 도구",
          "type": "choice",
          "options": [
            { "value": "none", "label": "도구 없이" },
            { "value": "lever", "label": "지레" },
            { "value": "ramp", "label": "빗면" }
          ],
          "default": "none"
        },
        {
          "key": "armCm",
          "label": "힘을 주는 쪽 길이",
          "type": "choice",
          "options": [
            { "value": "short", "label": "짧게" },
            { "value": "mid", "label": "중간" },
            { "value": "long", "label": "길게" }
          ],
          "default": "short"
        },
        {
          "key": "color",
          "label": "물체 색깔",
          "type": "choice",
          "options": [
            { "value": "red", "label": "빨간 상자" },
            { "value": "blue", "label": "파란 상자" }
          ],
          "default": "red"
        }
      ],
      "dependent": [
        { "key": "force", "label": "용수철저울 눈금", "unit": "g" },
        { "key": "pullCm", "label": "손으로 당긴 거리", "unit": "cm" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": [],
      "safetyNotices": [],
      "limits": ["일의 원리", "에너지", "돌림힘", "모멘트", "마찰력", "뉴턴"],
      "tutor": {
        "forbiddenAnswers": [
          "받침점에서 멀수록 힘이 적",
          "받침점에서 멀면 힘이 적",
          "받침점에서 멀어질수록 힘이",
          "받침점에서 멀수록 힘이 작",
          "받침점에서 멀수록 눈금이",
          "받침점에서 멀수록 쉬",
          "손이 받침점에서 멀수록",
          "손이 받침점에서 멀면",
          "빗면이 길수록 힘이 적",
          "빗면이 길면 힘이 적",
          "빗면이 길어질수록",
          "빗면이 길수록 힘이 작",
          "빗면이 길수록 눈금이",
          "빗면이 길수록 쉬",
          "빗면이 완만할수록",
          "빗면이 완만하면",
          "지레를 쓰면 힘이 덜",
          "지레를 쓰면 힘이 적",
          "빗면을 쓰면 힘이 덜",
          "빗면을 쓰면 힘이 적",
          "지레를 쓰면 힘이 작",
          "빗면을 쓰면 힘이 작",
          "도구를 쓰면 힘이 덜",
          "도구를 쓰면 힘이 적",
          "도구를 쓰면 힘이 작",
          "힘은 적게 드는 대신 더 많이 당",
          "힘이 적게 드는 대신",
          "색깔은 관계없",
          "색깔은 상관없",
          "색깔은 영향이 없",
          "색깔은 결과에 영향",
          "색깔과 관계없",
          "색깔이 달라도"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 용수철저울의 눈금이 어떻게 될지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 저울 눈금이 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 저울 눈금과 손으로 당긴 거리는 각각 어떻게 달라졌나요? 눈으로 보기 그림과 그래프를 함께 볼까요?" },
          { "when": "fair-test", "iv": "tool", "text": "쓰는 도구만 바꾸었어요. 같은 상자를 같은 높이로 들어 올릴 때 저울 눈금과 손으로 당긴 거리는 각각 어떻게 달라졌나요?" },
          { "when": "fair-test", "iv": "armCm", "text": "힘을 주는 쪽 길이만 바꾸었어요. 저울 눈금은 어떻게 달라졌나요? 도구 없이 들어 올릴 때도 달라졌는지 확인해 볼까요?" },
          { "when": "fair-test", "iv": "color", "text": "물체 색깔만 바꾸었을 때 저울 눈금은 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. '힘과 거리 보기' 그림에서 두 막대가 어떻게 채워졌는지 견주어 볼까요?" }
        ]
      }
    }
  ]
}
