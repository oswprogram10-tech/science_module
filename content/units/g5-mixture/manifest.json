{
  "id": "g5-mixture",
  "title": "혼합물의 분리",
  "grade": 5,
  "standards": ["6과05-03"],
  "engine": "matter",
  "experiments": [
    {
      "id": "salt-sand",
      "module": "salt-sand",
      "title": "소금과 모래의 혼합물 분리하기",
      "question": "소금과 모래가 섞인 혼합물에서 소금을 어떻게 분리할 수 있을까?",
      "predictionPrompt": "예측: 얻은 소금의 양은?",
      "variables": [
        {
          "key": "waterMl",
          "label": "넣는 물의 양",
          "type": "choice",
          "unit": "mL",
          "options": [
            { "value": 20, "label": "20 mL" },
            { "value": 50, "label": "50 mL" }
          ],
          "default": 50
        },
        {
          "key": "filter",
          "label": "거르는 방법",
          "type": "choice",
          "options": [
            { "value": "paper", "label": "거름종이로 거르기" },
            { "value": "pour", "label": "거름종이 없이 윗물만 따르기" }
          ],
          "default": "paper"
        },
        {
          "key": "stirrer",
          "label": "젓는 도구",
          "type": "choice",
          "options": [
            { "value": "glass", "label": "유리 막대" },
            { "value": "wood", "label": "나무 젓가락" }
          ],
          "default": "glass"
        }
      ],
      "dependent": [
        { "key": "salt", "label": "얻은 소금", "unit": "g" },
        { "key": "sand", "label": "섞인 모래", "unit": "g" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": ["heat"],
      "safetyChecklist": [
        "보안경을 썼어요.",
        "가열하는 증발 접시는 맨손으로 만지지 않아요.",
        "알코올램프 주변에 종이를 두지 않았어요."
      ],
      "safetyMessages": {
        "NO_GOGGLES": "알코올램프를 켜기 전에 보안경을 먼저 착용해 주세요!",
        "NO_GLOVES": "증발 접시는 아주 뜨거워요. 맨손으로 만지지 말고 장갑을 먼저 껴 주세요!",
        "SPILL": "물이나 소금물이 쏟아졌어요! 알코올램프 가까이라면 불을 끄고 바로 선생님께 알려 주세요.",
        "FOOD": "실험하는 동안에는 소금물이나 접시 위 가루를 먹지 않아요!"
      },
      "safetyNotices": [],
      "limits": ["순도", "포화 용액", "재결정", "용해도 곡선", "여과액"],
      "params": { "totalMin": 20 },
      "tutor": {
        "forbiddenAnswers": [
          "물이 적으면 소금이 다 녹지 않",
          "소금이 다 녹지 않",
          "다 녹지 않아",
          "물을 많이 넣으면 소금을 더 많이",
          "소금을 더 많이 얻",
          "거름종이로 걸러야 모래가 섞이지 않",
          "모래가 섞이지 않",
          "모래가 섞여",
          "소금은 물에 녹고 모래는 녹지 않",
          "물에 녹고 모래는",
          "모래는 물에 녹지 않",
          "젓는 도구는 관계없",
          "젓는 도구는 상관없",
          "젓는 도구는 결과에 영향"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 얻는 소금의 양이 어떻게 될지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 결과가 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 얻은 소금과 섞인 모래는 각각 어떻게 되었나요?" },
          { "when": "fair-test", "iv": "waterMl", "text": "물의 양만 바꾸었어요. 녹이는 동안 비커 바닥에 남은 것은 무엇이었나요? 알갱이 그림에서 녹지 않고 남은 소금이 보이나요?" },
          { "when": "fair-test", "iv": "filter", "text": "거르는 방법만 바꾸었어요. 얻은 소금의 양은 같았는데, 증발 접시 위 가루는 어떻게 달랐나요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. 그래프에서 접시 위 고체가 언제부터 늘기 시작했는지 볼까요?" }
        ]
      }
    }
  ]
}
