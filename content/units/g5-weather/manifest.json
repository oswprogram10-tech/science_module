{
  "id": "g5-weather",
  "title": "날씨와 우리 생활",
  "grade": 5,
  "standards": ["6과10-04"],
  "engine": "earth",
  "experiments": [
    {
      "id": "land-sea-breeze",
      "module": "land-sea-breeze",
      "title": "모래와 물이 데워지고 식는 빠르기와 바람 알아보기",
      "question": "낮과 밤에 바닷가에서는 바람이 어느 쪽으로 불까?",
      "predictionPrompt": "예측: 모래 온도와 물 온도의 차이(모래 − 물)는?",
      "variables": [
        {
          "key": "phase",
          "label": "때",
          "type": "choice",
          "options": [
            { "value": "day", "label": "낮 (전등을 켠 10분)" },
            { "value": "night", "label": "밤 (전등을 끈 뒤 10분)" }
          ],
          "default": "day"
        },
        {
          "key": "lampCm",
          "label": "전등과의 거리",
          "type": "choice",
          "unit": "cm",
          "options": [
            { "value": 20, "label": "20 cm" },
            { "value": 40, "label": "40 cm" }
          ],
          "default": 20
        },
        {
          "key": "bowl",
          "label": "그릇",
          "type": "choice",
          "options": [
            { "value": "plastic", "label": "플라스틱 그릇" },
            { "value": "glass", "label": "유리 그릇" }
          ],
          "default": "plastic"
        }
      ],
      "dependent": [
        { "key": "diff", "label": "온도 차(모래 − 물)", "unit": "°C" },
        { "key": "sand", "label": "모래 온도", "unit": "°C" },
        { "key": "water", "label": "물 온도", "unit": "°C" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": ["heat", "fire"],
      "safetyChecklist": [
        "전등은 뜨거우니 갓을 만지지 않아요.",
        "향은 선생님이 피워 주시고, 불씨 가까이에 종이를 두지 않아요.",
        "실험이 끝나면 향을 물에 담가 끄어요."
      ],
      "safetyMessages": {
        "NO_GOGGLES": "향과 전등을 켜기 전에 보안경을 먼저 착용해 주세요!",
        "NO_GLOVES": "전등과 향 가까이에서는 뜨거울 수 있어요. 장갑을 먼저 껴 주세요!",
        "SPILL": "물이나 모래가 쏟아졌어요! 전등과 향에서 떨어지고 바로 선생님께 알려 주세요.",
        "FOOD": "실험하는 동안에는 모래나 물을 먹거나 맛보지 않아요!"
      },
      "safetyNotices": [],
      "limits": ["비열", "대류", "해풍", "육풍", "기압 경도력", "열용량"],
      "params": { "totalMin": 10 },
      "tutor": {
        "forbiddenAnswers": [
          "모래가 물보다 빨리 데워",
          "모래가 물보다 빨리 식",
          "낮에는 바다에서 육지로",
          "밤에는 육지에서 바다로",
          "따뜻한 공기가 위로 올라가",
          "그릇은 관계없",
          "모래가 더 빨리 데워",
          "모래가 빨리 데워",
          "모래가 물보다 빨리 뜨거워",
          "모래가 더 빨리 뜨거워",
          "모래가 빨리 뜨거워",
          "모래가 더 빨리 식",
          "모래가 빨리 식",
          "모래는 물보다 빨리",
          "모래는 빨리 데워",
          "모래는 빨리 식",
          "물이 모래보다 천천히",
          "물이 더 천천히",
          "물은 천천히 데워",
          "물은 천천히 식",
          "육지가 바다보다 빨리",
          "바다에서 육지로 불어",
          "육지에서 바다로 불어",
          "바다에서 육지로 바람",
          "육지에서 바다로 바람",
          "낮에는 바다에서",
          "밤에는 육지에서",
          "따뜻한 공기는 위로",
          "따뜻한 공기가 위로",
          "공기가 위로 올라가",
          "공기는 위로 올라가",
          "공기가 위로 올라간",
          "공기는 위로 올라간",
          "공기가 위로 떠",
          "공기는 위로 떠",
          "그릇은 상관없",
          "그릇은 결과에 영향",
          "그릇은 영향이 없",
          "그릇과 관계없이",
          "그릇이 달라도 같"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 모래와 물의 온도 차이가 어떻게 될지 예측해 볼까요? 향 연기는 어느 쪽으로 흐를까요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 결과가 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 두 온도 선과 향 연기의 방향은 어떻게 달라졌나요?" },
          { "when": "fair-test", "iv": "phase", "text": "때만 바꾸었어요. 어느 쪽이 더 따뜻했나요? 공기의 움직임 그림에서 화살표가 위로 올라가는 곳은 어디였나요?" },
          { "when": "fair-test", "iv": "bowl", "text": "그릇만 바꾸었을 때 결과가 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. 그래프에서 두 선이 벌어지는 빠르기를 비교해 볼까요?" }
        ]
      }
    }
  ]
}
