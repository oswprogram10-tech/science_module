          "key": "wash",
          "label": "손 씻기",
          "type": "choice",
          "options": [
            {
              "value": "rarely",
              "label": "잘 안 씻음"
            },
            {
              "value": "often",
              "label": "자주 씻음"
            }
          ],
          "default": "rarely"
        },
        {
          "key": "mask",
          "label": "마스크",
          "type": "choice",
          "options": [
            {
              "value": "off",
              "label": "안 씀"
            },
            {
              "value": "on",
              "label": "씀"
            }
          ],
          "default": "off"
        },
        {
          "key": "contacts",
          "label": "하루에 가까이 만나는 친구 수",
          "type": "choice",
          "unit": "명",
          "options": [
            {
              "value": 4,
              "label": "4명"
            },
            {
              "value": 8,
              "label": "8명"
            }
          ],
          "default": 4
        },
        {
          "key": "seat",
          "label": "처음 아픈 친구의 자리",
          "type": "choice",
          "options": [
            {
              "value": "front",
              "label": "앞줄"
            },
            {
              "value": "back",
              "label": "뒷줄"
            }
          ],
          "default": "front"
        }
      ],
      "dependent": [
        {
          "key": "total",
          "label": "20일 동안 감염된 사람",
          "unit": "명"
        },
        {
          "key": "peak",
          "label": "가장 많이 아팠던 날의 아픈 사람",
          "unit": "명"
        }
