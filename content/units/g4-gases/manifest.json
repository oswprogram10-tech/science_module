      "predictionPrompt": "예측: 페트병의 무게는?",
      "variables": [
        {
          "key": "pumps",
          "label": "공기 주입 마개를 누른 횟수",
          "type": "choice",
          "unit": "번",
          "options": [
            { "value": 0, "label": "0번" },
            { "value": 20, "label": "20번" },
            { "value": 40, "label": "40번" },
            { "value": 60, "label": "60번" }
          ],
          "default": 0
        },
        {
          "key": "cap",
          "label": "마개",
          "type": "choice",
          "options": [
            { "value": "closed", "label": "닫아 둠" },
            { "value": "open", "label": "열어서 공기를 뺌" }
          ],
          "default": "closed"
        },
        {
          "key": "label",
          "label": "페트병 띠지 색깔",
          "type": "choice",
          "options": [
            { "value": "red", "label": "빨간색" },
            { "value": "blue", "label": "파란색" }
          ],
          "default": "red"
        }
      ],
      "dependent": [
        { "key": "weight", "label": "전자저울 무게", "unit": "g" },
        { "key": "firm", "label": "손으로 눌렀을 때", "unit": "", "values": {"soft": "말랑함", "slight": "조금 단단함", "firm": "단단함", "hard": "아주 단단함"} }
