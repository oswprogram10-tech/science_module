    {
      "id": "solar-panel",
      "module": "solar-panel",
      "title": "태양광 패널이 만드는 전기의 양 알아보기",
      "question": "태양광 패널이 전기를 더 많이 만들게 하려면 어떻게 해야 할까?",
      "predictionPrompt": "예측: 패널이 만든 전기의 양은?",
      "variables": [
        {
          "key": "tilt",
          "label": "패널 기울기",
          "type": "choice",
          "unit": "°",
          "options": [
            {
              "value": 0,
              "label": "0° (바닥에 눕힘)"
            },
            {
              "value": 30,
              "label": "30°"
            },
            {
              "value": 60,
              "label": "60°"
            }
          ],
          "default": 0
        },
        {
          "key": "weather",
          "label": "날씨",
          "type": "choice",
          "options": [
            {
              "value": "sunny",
              "label": "맑은 날"
            },
            {
              "value": "cloudy",
              "label": "흐린 날"
            }
          ],
          "default": "sunny"
        },
        {
          "key": "shade",
          "label": "그늘",
          "type": "choice",
          "options": [
            {
              "value": "none",
              "label": "없음"
            },
            {
              "value": "half",
              "label": "패널 절반을 가림"
            }
          ],
          "default": "none"
        },
        {
          "key": "frame",
          "label": "패널 테두리 색",
          "type": "choice",
          "options": [
            {
              "value": "black",
              "label": "검은색"
            },
            {
              "value": "silver",
              "label": "은색"
            }
          ],
          "default": "black"
        }
      ],
      "dependent": [
        {
          "key": "power",
          "label": "만든 전기",
          "unit": "mW"
        },
        {
          "key": "turns",
          "label": "1분 동안 프로펠러가 돈 횟수",
          "unit": "번"
        }
