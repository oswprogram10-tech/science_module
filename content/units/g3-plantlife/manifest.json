          "features": {
            "serrated": "yes",
            "lobed": "no",
            "parallel": "no"
          },
          "observations": {
            "serrated": "가장자리에 아주 작은 톱니가 있어요.",
            "lobed": "갈라지지 않은 길쭉한 둥근 모양이고 반질반질해요.",
