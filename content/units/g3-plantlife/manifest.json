            "parallel": "no"
          },
          "observations": {
            "serrated": "가장자리가 매끈해요.",
            "lobed": "갈라지지 않은 하트 모양이에요.",
            "parallel": "잎맥이 그물처럼 퍼져 있어요."
          }
        },
        {
          "key": "iris",
          "label": "붓꽃",
          "icon": "iris",
          "features": {
            "serrated": "no",
            "lobed": "no",
            "parallel": "yes"
          },
          "observations": {
            "serrated": "가장자리가 매끈해요.",
            "lobed": "갈라지지 않은 칼처럼 긴 모양이에요.",
            "parallel": "잎맥이 잎 끝까지 나란히 뻗어 있어요."
          }
        },
        {
          "key": "lily",
          "label": "백합",
          "icon": "lily",
          "features": {
            "serrated": "no",
            "lobed": "no",
            "parallel": "yes"
          },
          "observations": {
            "serrated": "가장자리가 매끈해요.",
            "lobed": "갈라지지 않은 길쭉한 모양이에요.",
            "parallel": "잎맥이 잎 끝까지 나란히 뻗어 있어요."
          }
        }
      ],
      "tutor": {
        "forbiddenAnswers": [
          "붓꽃과 백합은 잎맥이 나란",
          "단풍나무는 갈라져",
          "단풍나무와 국화는 같은 무리",
          "감나무와 라일락은 같은 무리",
          "벚나무는 톱니",
          "감나무는 가장자리가 매끈",
          "잎이 예쁜가는 분류 기준이 될 수 없"
        ],
        "probes": [
          {
            "when": "choose-criterion",
            "text": "이 무리를 두 갈래로 나누려면 어떤 질문이 좋을까요? 누가 답해도 같은 질문을 골라 보세요."
          },
          {
            "when": "pick-card",
            "text": "어떤 잎부터 살펴볼까요?"
          },
          {
            "when": "before-observe",
            "text": "{card} 잎을 넣기 전에 '{criterion}'에 맞는 생김새를 먼저 살펴볼까요?"
          },
          {
            "when": "sorting",
            "text": "{card} 잎을 관찰한 내용으로 보면 '예'일까요, '아니요'일까요? 왜 그렇게 생각했나요?"
          },
          {
            "when": "check-subjective",
            "text": "'{criterion}'에 친구와 내가 같은 답을 할까요? 누가 답해도 같은 질문인지 생각해 볼까요?"
          },
          {
            "when": "check-unplaced",
            "text": "아직 넣지 않은 잎이 있어요. 모든 잎을 넣어 볼까요?"
          },
          {
            "when": "check-unobserved",
            "text": "{card} 잎은 아직 살펴보지 않았어요. 돋보기로 먼저 관찰해 볼까요?"
          },
          {
            "when": "check-inconsistent",
            "text": "{card} 잎에서 관찰한 내용과 넣은 쪽을 다시 비교해 볼까요?"
          },
          {
            "when": "check-complete",
            "text": "관찰한 생김새와 잘 맞게 나누었어요."
          },
          {
            "when": "tree-split-empty",
            "text": "모든 잎이 한쪽으로 모였어요. 이 질문으로는 나누어지지 않았어요. 다른 질문을 골라 볼까요?"
          },
          {
            "when": "tree-next-node",
            "text": "아직 더 나눌 수 있는 무리가 있을까요? 무리를 하나 골라 다시 나누어 볼까요?"
          },
          {
            "when": "finished",
            "text": "더 나눌 수 없을 때까지 나누었어요. 처음 질문을 바꾸면 트리 모양이 어떻게 달라질까요?"
          }
        ]
      }
    }
  ]
}
