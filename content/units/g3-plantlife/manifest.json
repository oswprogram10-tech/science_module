          "observations": {
            "serrated": "가장자리가 매끈해요.",
            "lobed": "갈라지지 않은 넓은 달걀 모양이에요.",
            "parallel": "잎맥이 그물처럼 퍼져 있어요."
          }
        },
        {
          "key": "lilac",
          "label": "라일락",
          "icon": "lilac",
          "features": {
