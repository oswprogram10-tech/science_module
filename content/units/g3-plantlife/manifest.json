            },
            {
              "value": "no",
              "label": "갈라져 있지 않다"
            }
          ]
        },
        {
          "key": "parallel",
          "label": "잎맥이 나란한가요?",
          "feature": "parallel",
          "objective": true,
          "groups": [
            {
              "value": "yes",
              "label": "잎맥이 나란하다"
            },
            {
              "value": "no",
              "label": "잎맥이 나란하지 않다"
