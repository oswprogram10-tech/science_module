            "parallel": "no"
          },
          "observations": {
            "serrated": "갈라진 조각 끝에 톱니가 있어요.",
            "lobed": "잎이 여러 갈래로 갈라져 있어요.",
            "parallel": "잎맥이 그물처럼 퍼져 있어요."
          }
        },
        {
          "key": "cherry",
          "label": "벚나무",
          "icon": "cherry",
          "features": {
            "serrated": "yes",
            "lobed": "no",
