{
  "id": "g6-acid-base",
  "title": "산과 염기",
  "grade": 6,
  "standards": ["6과09-01", "6과09-02"],
  "engine": "matter",
  "experiments": [
    {
      "id": "indicator-classify",
      "module": "indicator-classify",
      "title": "지시약으로 여러 가지 용액 분류하기",
      "question": "지시약을 이용하면 여러 가지 용액을 어떻게 분류할 수 있을까?",
      "groups": [
        { "key": "acid", "label": "산성 용액" },
        { "key": "base", "label": "염기성 용액" }
      ],
      "solutions": [
        { "key": "hcl", "label": "묽은 염산", "level": 1.0, "hazard": true },
        { "key": "lemon", "label": "레몬즙", "level": 2.3 },
        { "key": "vinegar", "label": "식초", "level": 2.8 },
        { "key": "soda", "label": "탄산수", "level": 4.5 },
        { "key": "soap", "label": "빨랫비누 물", "level": 10.0 },
        { "key": "cleaner", "label": "유리 세정제", "level": 11.0 },
        { "key": "limewater", "label": "석회수", "level": 12.4 },
        { "key": "naoh", "label": "묽은 수산화 나트륨 용액", "level": 13.0, "hazard": true }
      ],
      "indicators": [
        {
          "key": "blueLitmus",
          "label": "푸른색 리트머스 종이",
          "kind": "paper",
          "colors": [
            { "max": 7, "color": "red" },
            { "max": 99, "color": "blue" }
          ],
          "initial": "blue"
        },
        {
          "key": "redLitmus",
          "label": "붉은색 리트머스 종이",
          "kind": "paper",
          "colors": [
            { "max": 7, "color": "red" },
            { "max": 99, "color": "blue" }
          ],
          "initial": "red"
        },
        {
          "key": "phenol",
          "label": "페놀프탈레인 용액",
          "kind": "drop",
          "colors": [
            { "max": 8.2, "color": "clear" },
            { "max": 99, "color": "magenta" }
          ],
          "initial": "clear"
        },
        {
          "key": "cabbage",
          "label": "붉은 양배추 지시약",
          "kind": "drop",
          "colors": [
            { "max": 2.5, "color": "cabRed" },
            { "max": 6, "color": "cabPink" },
            { "max": 8, "color": "cabPurple" },
            { "max": 10.5, "color": "cabBlue" },
            { "max": 12, "color": "cabGreen" },
            { "max": 99, "color": "cabYellow" }
          ],
          "initial": "cabPurple"
        }
      ],
      "colors": {
        "red": { "label": "붉은색", "hex": "#d0605e", "pattern": "diagonal" },
        "blue": { "label": "푸른색", "hex": "#5b7fc7", "pattern": "dots" },
        "clear": { "label": "색 변화 없음", "hex": "#f1f1ee", "pattern": "none" },
        "magenta": { "label": "붉은색", "hex": "#e0479e", "pattern": "diagonal" },
        "cabRed": { "label": "붉은색", "hex": "#d6336c", "pattern": "diagonal" },
        "cabPink": { "label": "연한 붉은색", "hex": "#c86fa8", "pattern": "diagonal-sparse" },
        "cabPurple": { "label": "보라색", "hex": "#7b4e9b", "pattern": "cross" },
        "cabBlue": { "label": "푸른색", "hex": "#3a8fb7", "pattern": "dots" },
        "cabGreen": { "label": "초록색", "hex": "#3fa36b", "pattern": "horizontal" },
        "cabYellow": { "label": "노란색", "hex": "#c9c23a", "pattern": "vertical" }
      },
      "safety": ["goggles", "gloves", "corrosive"],
      "safetyChecklist": [
        "보안경을 썼어요.",
        "실험용 장갑을 꼈어요.",
        "용액을 맛보거나 코를 대고 냄새를 맡지 않아요."
      ],
      "safetyNotices": [],
      "limits": ["pH", "수소 이온", "수산화 이온", "이온", "분자", "중화"],
      "tutor": {
        "forbiddenAnswers": [
          "산성 용액은 푸른색 리트머스 종이를 붉게",
          "염기성 용액은 붉은색 리트머스 종이를 푸르게",
          "염기성 용액에서 페놀프탈레인",
          "식초는 산성 용액",
          "레몬즙은 산성 용액",
          "석회수는 염기성 용액",
          "빨랫비누 물은 염기성 용액"
        ],
        "probes": [
          { "when": "before-test", "text": "{solution}은(는) 산성일까요, 염기성일까요? 왜 그렇게 생각했나요?" },
          { "when": "testing", "text": "{solution}에 지시약을 넣었을 때 색이 어떻게 변했나요? 다른 지시약으로도 확인해 볼까요?" },
          { "when": "prediction-mismatch", "text": "{solution}에 대한 예측과 관찰 결과가 달랐네요. 어느 지시약의 색 변화를 보고 생각이 바뀌었나요?" },
          { "when": "check-untested", "text": "아직 지시약으로 확인하지 않은 용액이 있어요. 무엇을 보고 분류할 수 있을까요?" },
          { "when": "check-inconsistent", "text": "{solution}의 지시약 색 변화를 결과표에서 다시 살펴볼까요? 같은 무리에 넣은 다른 용액들과 비교해 보세요." },
          { "when": "check-complete", "text": "같은 무리에 넣은 용액들은 지시약 색 변화에서 어떤 공통점이 있나요?" }
        ]
      }
    },
    {
      "id": "acid-base-mix",
      "module": "acid-base-mix",
      "title": "산성 용액과 염기성 용액 섞기",
      "question": "산성 용액에 염기성 용액을 조금씩 넣으면 용액의 성질은 어떻게 변할까?",
      "predictionPrompt": "예측: 색 띠에서 지시약 색의 자리는?",
      "variables": [
        {
          "key": "drops",
          "label": "넣은 방울 수",
          "type": "choice",
          "unit": "방울",
          "options": [
            { "value": 0, "label": "0방울" },
            { "value": 10, "label": "10방울" },
            { "value": 20, "label": "20방울" },
            { "value": 30, "label": "30방울" },
            { "value": 40, "label": "40방울" }
          ],
          "default": 0
        },
        {
          "key": "direction",
          "label": "넣는 방향",
          "type": "choice",
          "options": [
            { "value": "acid", "label": "묽은 염산 10 mL에 묽은 수산화 나트륨 용액을 넣음" },
            { "value": "base", "label": "묽은 수산화 나트륨 용액 10 mL에 묽은 염산을 넣음" }
          ],
          "default": "acid"
        },
        {
          "key": "indicator",
          "label": "지시약",
          "type": "choice",
          "options": [
            { "value": "cabbage", "label": "붉은 양배추 지시약" },
            { "value": "phenol", "label": "페놀프탈레인 용액" }
          ],
          "default": "cabbage"
        },
        {
          "key": "beaker",
          "label": "비커 크기",
          "type": "choice",
          "unit": "mL",
          "options": [
            { "value": 50, "label": "50 mL" },
            { "value": 100, "label": "100 mL" }
          ],
          "default": 50
        }
      ],
      "dependent": [
        { "key": "color", "label": "지시약 색", "unit": "" },
        { "key": "addedMl", "label": "넣은 양", "unit": "mL" },
        { "key": "slot", "label": "색 띠에서의 자리", "unit": "칸" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": ["goggles", "gloves", "corrosive"],
      "safetyChecklist": [
        "보안경을 썼어요.",
        "실험용 장갑을 꼈어요.",
        "용액을 맛보거나 코를 대고 냄새를 맡지 않아요."
      ],
      "safetyMessages": {
        "NO_GOGGLES": "산성 용액 실험 전 보안경을 먼저 착용해 주세요!",
        "NO_GLOVES": "용액을 만지기 전에 실험용 장갑을 먼저 껴 주세요!",
        "SPILL": "용액이 쏟아졌어요! 손대지 말고 바로 선생님께 알려 주세요.",
        "FOOD": "실험 중에는 음식을 먹거나 용액을 맛보면 안 돼요!"
      },
      "safetyNotices": [],
      "limits": ["pH", "수소 이온", "수산화 이온", "몰", "중화열", "염"],
      "tutor": {
        "forbiddenAnswers": [
          "중화",
          "중성이 되",
          "중성이 돼",
          "중성으로",
          "산성이 약해",
          "산성이 점점 약해",
          "산성이 줄어",
          "산성이 사라",
          "산성이 없어",
          "염기성이 약해",
          "염기성이 점점 약해",
          "염기성으로 변",
          "염기성이 강해",
          "산성으로 변",
          "산성이 강해",
          "비커 크기는 관계없",
          "비커 크기는 상관없",
          "비커 크기는 영향이 없",
          "비커 크기와 관계없",
          "비커 크기가 달라도"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 지시약 색이 색 띠에서 어디로 갈지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 지시약 색이 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 지시약 색은 어떻게 달라졌나요? 색 띠 기록에서 칸의 자리를 견주어 볼까요?" },
          { "when": "fair-test", "iv": "drops", "text": "넣은 방울 수만 바꾸었어요. 방울 수가 늘어남에 따라 지시약 색은 어떤 순서로 달라졌나요? 색 띠 기록에서 찾아볼까요?" },
          { "when": "fair-test", "iv": "direction", "text": "넣는 방향만 바꾸었어요. 같은 방울 수에서 지시약 색은 어떻게 달랐나요? 처음 색부터 비교해 볼까요?" },
          { "when": "fair-test", "iv": "indicator", "text": "지시약만 바꾸었어요. 같은 용액에서 두 지시약의 색은 각각 어떻게 달랐나요? 색 이름과 색 띠의 칸 수도 함께 견주어 볼까요?" },
          { "when": "fair-test", "iv": "beaker", "text": "비커 크기만 바꾸었을 때 지시약 색은 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. 색 띠 기록에서 방울 수에 따른 색 이름을 하나씩 짚어 보고, 어느 방울 수에서 색이 바뀌었는지 찾아볼까요?" }
        ]
      }
    }
  ]
}
