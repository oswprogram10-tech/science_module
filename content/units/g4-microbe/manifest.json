{
  "id": "g4-microbe",
  "title": "다양한 생물과 우리 생활",
  "grade": 4,
  "standards": ["4과12-01"],
  "engine": "life",
  "experiments": [
    {
      "id": "mold-growth",
      "module": "mold-growth",
      "title": "곰팡이가 잘 자라는 조건 알아보기",
      "question": "곰팡이는 어떤 조건에서 잘 자랄까?",
      "predictionPrompt": "예측: 7일째 곰팡이가 덮은 넓이는?",
      "variables": [
        {
          "key": "moisture",
          "label": "빵의 물기",
          "type": "choice",
          "options": [
            { "value": "dry", "label": "마른 빵" },
            { "value": "wet", "label": "물을 뿌린 빵" }
          ],
          "default": "wet"
        },
        {
          "key": "tempC",
          "label": "온도",
          "type": "choice",
          "unit": "°C",
          "options": [
            { "value": 5, "label": "냉장고 5 °C" },
            { "value": 20, "label": "실온 20 °C" },
            { "value": 30, "label": "따뜻한 곳 30 °C" }
          ],
          "default": 20
        },
        {
          "key": "light",
          "label": "빛",
          "type": "choice",
          "options": [
            { "value": "bright", "label": "밝은 곳" },
            { "value": "dark", "label": "어두운 곳" }
          ],
          "default": "bright"
        }
      ],
      "dependent": [
        { "key": "cover7", "label": "7일째 곰팡이 넓이", "unit": "%" },
        { "key": "firstDay", "label": "곰팡이가 처음 보인 날", "unit": "일" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": ["microbe"],
      "safetyChecklist": [
        "곰팡이가 핀 봉지는 열지 않고 밖에서만 관찰해요.",
        "곰팡이 냄새를 맡거나 손으로 만지지 않아요.",
        "관찰이 끝난 봉지는 선생님이 버려요."
      ],
      "safetyMessages": {
        "NO_GOGGLES": "관찰할 때는 봉지를 열지 말고 보안경을 써 주세요!",
        "NO_GLOVES": "곰팡이 봉지를 옮길 때는 장갑을 껴 주세요!",
        "SPILL": "봉지가 터졌어요! 손대지 말고 선생님께 바로 알려 주세요.",
        "FOOD": "곰팡이가 핀 빵은 절대 먹으면 안 돼요!"
      },
      "safetyNotices": [],
      "limits": ["효소", "학명", "페니실리움", "아스페르길루스", "미생물학"],
      "params": { "days": 10 },
      "tutor": {
        "forbiddenAnswers": [
          "축축할수록 곰팡이가 잘 자라",
          "따뜻할수록 곰팡이가 잘 자라",
          "냉장고에서는 곰팡이가 자라지 않",
          "빛은 곰팡이와 관계없",
          "물기가 있어야 곰팡이가"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 곰팡이가 덮은 넓이가 어떻게 될지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 곰팡이 넓이가 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 곰팡이가 덮은 넓이와 처음 보인 날은 각각 어떻게 달라졌나요? 결과표의 두 칸을 함께 볼까요?" },
          { "when": "fair-test", "iv": "tempC", "text": "온도만 바꾸었어요. 7일째와 10일째 그래프를 함께 보면 냉장고 속 빵에서는 무슨 일이 일어났나요?" },
          { "when": "fair-test", "iv": "light", "text": "빛만 바꾸었을 때 결과가 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. 가상 현미경으로 본 곰팡이의 모습과 그래프를 함께 살펴볼까요?" }
        ],
        "answers": [
          {
            "iv": "moisture",
            "conclusion": "물기가 있고 축축할수록 곰팡이가 잘 자란다",
            "keys": [
              ["물", "축축", "젖", "습", "촉촉", "수분", "물기"],
              ["곰팡이", "자라", "핀", "피", "번식"],
              ["잘", "많", "있어야", "빨리", "더", "필요"]
            ],
            "not": ["축축할수록곰팡이가안", "축축하면곰팡이가안", "축축할수록곰팡이가덜", "축축하면곰팡이가덜", "물기가있으면곰팡이가안", "물기가있어도", "물을뿌려도", "물을뿌린빵에곰팡이가안", "마른빵이더", "없어도", "상관없", "관계없"],
            "confirm": "네, 결과표에서도 물을 뿌린 빵에서 곰팡이가 더 넓게 퍼졌어요."
          },
          {
            "iv": "tempC",
            "conclusion": "따뜻할수록 곰팡이가 잘 자란다",
            "keys": [
              ["따뜻", "온도", "더울", "뜨거", "30도", "높"],
              ["곰팡이", "자라", "핀", "피", "번식"],
              ["잘", "많", "빨리", "더", "필요"]
            ],
            "not": ["따뜻할수록곰팡이가안", "따뜻할수록곰팡이가못", "따뜻할수록곰팡이가덜", "따뜻하면곰팡이가안", "따뜻하면곰팡이가못", "따뜻하면곰팡이가덜", "온도가높을수록곰팡이가안", "온도가높을수록곰팡이가덜", "온도가높으면곰팡이가안", "온도가높으면곰팡이가덜", "차가울수록잘자", "추울수록잘자"],
            "confirm": "네, 결과표에서도 온도가 높은 쪽 빵에서 곰팡이가 더 넓게 퍼졌어요."
          },
          {
            "iv": "tempC",
            "conclusion": "냉장고처럼 차가운 곳에서는 곰팡이가 잘 자라지 않는다",
            "keys": [
              ["냉장", "차가", "추운", "차갑", "5도", "낮"],
              ["곰팡이", "자라", "핀", "피", "번식"],
              ["안", "못", "않", "느리", "적", "덜", "늦"]
            ],
            "not": ["잘자", "빨리", "더많"],
            "confirm": "네, 결과표에서도 온도가 낮은 쪽 빵에서는 곰팡이가 더 적게 자랐어요."
          },
          {
            "iv": "light",
            "conclusion": "빛은 결과와 관계없다",
            "keys": [
              ["빛", "어두", "밝"],
              ["관계없", "상관없", "영향이없", "영향없", "영향을주지않", "차이가없", "차이없", "똑같", "같아", "같다", "어두워도", "밝아도"]
            ],
            "not": ["관계있", "상관있", "영향이있", "영향을줘", "영향을준", "중요해", "달라요", "달라져요", "달라진다", "달라졌", "다르다", "다릅"],
            "confirm": "네, 결과표에서도 빛만 바꿔도 결과가 비슷했어요."
          }
        ]
      }
    }
  ]
}
