{
  "id": "g4-climate",
  "title": "기후변화와 우리 생활",
  "grade": 4,
  "standards": ["4과16-01", "4과16-02"],
  "engine": "ssi",
  "experiments": [
    {
      "id": "greenhouse-bottle",
      "module": "greenhouse-bottle",
      "title": "온실 모형으로 온도 변화 알아보기",
      "question": "공기층을 덮거나 이산화 탄소를 늘리면 병 속 온도는 어떻게 달라질까?",
      "predictionPrompt": "예측: 20분 동안 오른 온도는?",
      "variables": [
        {
          "key": "cover",
          "label": "투명 비닐 덮개",
          "type": "choice",
          "options": [
            { "value": "none", "label": "없음" },
            { "value": "film", "label": "씌움" }
          ],
          "default": "none"
        },
        {
          "key": "air",
          "label": "병 속 공기",
          "type": "choice",
          "options": [
            { "value": "normal", "label": "보통 공기" },
            { "value": "co2", "label": "이산화 탄소를 더 넣은 공기" }
          ],
          "default": "normal"
        },
        {
          "key": "cap",
          "label": "병 뚜껑 색",
          "type": "choice",
          "options": [
            { "value": "white", "label": "흰색" },
            { "value": "blue", "label": "파란색" }
          ],
          "default": "white"
        }
      ],
      "dependent": [
        { "key": "rise", "label": "오른 온도", "unit": "°C" },
        { "key": "temp", "label": "20분 뒤 온도", "unit": "°C" }
      ],
      "gateway": { "mode": "open", "requirePrediction": true, "requireSingleIV": true },
      "safety": ["heat"],
      "safetyChecklist": [
        "전등 갓은 뜨거우니 만지지 않아요.",
        "이산화 탄소는 선생님이 넣어 주세요.",
        "실험이 끝나면 병을 열어 창가에서 공기를 빼요."
      ],
      "safetyMessages": {
        "NO_GOGGLES": "전등을 켜고 이산화 탄소를 다루기 전에 보안경을 먼저 착용해 주세요!",
        "NO_GLOVES": "전등 갓은 뜨거울 수 있어요. 가까이에서 병을 만지기 전에 장갑을 먼저 껴 주세요!",
        "SPILL": "병이 쓰러지거나 깨졌어요! 전등에서 떨어지고 바로 선생님께 알려 주세요.",
        "FOOD": "실험하는 동안에는 병 속 공기를 마시거나 이산화 탄소 재료를 먹거나 맛보지 않아요!"
      },
      "safetyNotices": [],
      "limits": ["복사 평형", "적외선 흡수", "복사 강제력", "탄소 순환", "ppm"],
      "params": { "totalMin": 20 },
      "tutor": {
        "forbiddenAnswers": [
          "덮개를 씌우면 온도가 더 올라",
          "이산화 탄소가 많으면 온도가 더 올라",
          "열이 빠져나가지 못하기 때문",
          "뚜껑 색은 관계없",
          "덮개를 씌우면 온도가 올라",
          "덮개를 씌우면 온도가 높아",
          "덮개를 씌우면 온도가 더 높",
          "덮개를 씌우면 더 올라",
          "덮개를 씌우면 더 높아",
          "덮개를 씌우면 더 뜨거",
          "덮개를 씌우면 더 따뜻",
          "덮개를 씌우면 훨씬",
          "덮개를 씌우면 많이 올라",
          "덮개를 씌울수록",
          "덮개를 씌운 병이 더",
          "덮개를 씌운 쪽이 더",
          "덮개가 있으면 온도가",
          "덮개가 있으면 더",
          "덮개가 있는 병이 더",
          "이산화 탄소가 많으면 온도가 올라",
          "이산화 탄소가 많으면 온도가 높아",
          "이산화 탄소가 많으면 더 올라",
          "이산화 탄소가 많으면 더 높아",
          "이산화 탄소가 많을수록",
          "이산화 탄소를 넣으면 온도가",
          "이산화 탄소를 넣으면 더 올라",
          "이산화 탄소를 더 넣으면",
          "이산화 탄소가 늘어나면",
          "이산화 탄소가 더 있으면",
          "열이 빠져나가지 못해서",
          "열이 빠져나가지 못하",
          "열이 빠져나가지 않",
          "열이 안 빠져나가",
          "열이 못 빠져나가",
          "열이 나가지 못",
          "열이 빠져나가는 것을 막",
          "열이 갇",
          "열을 가두",
          "열을 가둬",
          "열을 가둔",
          "열을 붙잡",
          "뚜껑 색은 상관없",
          "뚜껑 색은 영향이 없",
          "뚜껑 색은 결과에 영향",
          "뚜껑 색은 아무 영향",
          "뚜껑 색은 중요하지 않",
          "뚜껑 색과 관계없이",
          "뚜껑 색이 달라도 같",
          "뚜껑 색이 달라도 결과가 같",
          "뚜껑은 관계없",
          "뚜껑은 상관없"
        ],
        "probes": [
          { "when": "before-run", "text": "{iv}을(를) 바꾸면 병 속 온도가 어떻게 될지 예측해 볼까요? 왜 그렇게 생각했나요?" },
          { "when": "first-trial", "text": "이번 결과를 기준으로 삼을 거예요. 다음 시행에서는 무엇만 바꿔 볼까요?" },
          { "when": "confounded", "text": "{changed}이(가) 함께 바뀌었어요. 온도가 달라진 까닭이 어느 쪽 때문인지 어떻게 알아낼 수 있을까요?" },
          { "when": "iv-unchanged", "text": "{iv}은(는) 그대로인데 {changed}이(가) 바뀌었어요. 처음에 알아보려던 것을 확인하려면 다음에는 무엇을 바꿔야 할까요?" },
          { "when": "repeat", "text": "앞 시행과 조건이 같아요. 같은 결과가 다시 나왔나요? 결과가 같은지 확인하는 것은 왜 중요할까요?" },
          { "when": "fair-test", "text": "{iv}만 바꾸었을 때 오른 온도는 얼마나 달라졌나요? 그래프의 앞 시행 선과 비교해 볼까요?" },
          { "when": "fair-test", "iv": "air", "text": "병 속 공기만 바꾸었어요. 덮개를 바꾸었을 때와 비교하면 차이가 컸나요, 작았나요? 실제 지구에서는 어떨지 생각해 볼까요?" },
          { "when": "fair-test", "iv": "cap", "text": "뚜껑 색만 바꾸었을 때 결과가 달라졌나요? 이 결과로 무엇을 알 수 있을까요?" },
          { "when": "prediction-mismatch", "text": "예측과 결과가 달랐네요. 열이 드나드는 모습 그림에서 빠져나가는 화살표를 살펴볼까요?" }
        ]
      }
    }
  ]
}
